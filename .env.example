# Read-only ingest needs a token with `public_repo` scope (or `repo` for private).
# The gh CLI's token works: export CADENCE_GITHUB_TOKEN=$(gh auth token)
CADENCE_GITHUB_TOKEN=

CADENCE_DATABASE_URL=postgresql://localhost/cadence

# Where compressed logs land. Local path for now; S3-compatible (R2/B2) later.
CADENCE_LOG_STORE=./data/logs
